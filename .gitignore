# ============================================================
#  Сборка и локальные данные
# ============================================================
# Приложение запускается докером; локальные сборки в репозиторий не нужны.
bin/
data/
*.db
*.db-wal
*.db-shm

# Артефакты Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.prof
*.pprof
coverage.out
coverage.html
go.work
go.work.sum

# Каталог vendor Go — ТОЛЬКО в корне репозитория.
# Слеш в начале обязателен: без него правило поглотило бы
# internal/web/static/vendor/, а он хранится в репозитории намеренно —
# там лежит вьюер спецификаций, чтобы портал работал без выхода в интернет.
/vendor/
!internal/web/static/vendor/

# Ваш реестр сервисов обычно коммитят (см. ADR №4 в README): он живёт в git,
# изменения проходят ревью. Если в нём адреса, которые светить нельзя —
# раскомментируйте:
# services.yaml

# ============================================================
#  macOS
# ============================================================
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
Icon?
__MACOSX/

# ============================================================
#  Linux
# ============================================================
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================================
#  Windows
# ============================================================
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# ============================================================
#  IDE и редакторы
# ============================================================
# JetBrains (GoLand, IntelliJ IDEA)
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code. Если захотите поделиться на команду конфигурацией запуска —
# добавьте исключение вида: !.vscode/launch.json
.vscode/
*.code-workspace
.history/

# Vim
*.swp
*.swo
*.swn
Session.vim
.netrwhist
tags

# Emacs
\#*\#
.\#*
*_archive

# Sublime Text
*.sublime-workspace
*.sublime-project

# Zed
.zed/

# ============================================================
#  Прочее
# ============================================================
# Личные настройки Claude Code (общекомандные кладут в .claude/settings.json).
.claude/

# Локальные переопределения окружения
.env
.env.local
