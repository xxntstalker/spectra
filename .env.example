# Spectra — переменные окружения.
#
# Здесь только то, что нужно процессу до старта: где слушать, как дойти до
# базы, как дойти до Kubernetes. Всё, что оператор меняет на работающем
# портале — интервал опроса, таймауты, глубина истории, пауза между запросами —
# живёт в базе и правится на странице «Настройки». Иначе одно и то же значение
# принадлежало бы двум хозяевам сразу, и было бы неясно, кто победит.
#
# Копировать так:  cp .env.example .env
# Docker Compose подхватит .env сам; в Kubernetes значения приезжают из
# ConfigMap и Secret — см. deploy/k8s/01-spectra.yaml.
#
# Обязательная здесь ровно одна переменная: SPECTRA_DATABASE_URL.


# ─────────────────────────────────────────────────────────── базовое ──

# Адрес и порт HTTP-сервера внутри контейнера.
SPECTRA_LISTEN=:8080

# Порт на хосте. Читает не приложение, а docker-compose.yml — сюда его
# вынесли, чтобы занятый 8080 не приходилось править в самом compose-файле.
SPECTRA_PORT=8080

# debug | info | warn | error.
# debug печатает каждый пробуемый URL — то, с чего начинается разбор
# «почему у сервиса не нашлась спека».
SPECTRA_LOG_LEVEL=info

# ОБЯЗАТЕЛЬНО. Postgres, и только он: портал держит в базе реестр, настройки,
# все ревизии спек и выбор активного опрашивающего через advisory lock.
# Читается также голый DATABASE_URL — его подставляют многие платформы.
SPECTRA_DATABASE_URL=postgres://spectra:spectra@postgres:5432/spectra?sslmode=disable

# Выключает опрос на этой реплике, оставляя ей только отдачу UI.
# Одну активную реплику опроса и так гарантирует блокировка в базе; эта
# переменная — для случая, когда чтение и запись разносят намеренно.
SPECTRA_POLLER_ENABLED=true


# ────────────────────────────────────────────────────── Kubernetes ──

# Откуда берётся список сервисов: Spectra читает Ingress через API-сервер.
# Пустое значение = автоопределение: включится в поде с примонтированным
# ServiceAccount и останется выключенным на ноутбуке.
SPECTRA_K8S_ENABLED=false

# Адрес API-сервера и токен. В поде не задаются: адрес приходит из
# KUBERNETES_SERVICE_HOST/PORT, который проставляет kubelet, а токен читается
# из /var/run/secrets/kubernetes.io/serviceaccount/token.
# Эти две переменные нужны, только чтобы смотреть на кластер снаружи —
# при разработке.
# SPECTRA_K8S_API_SERVER=https://127.0.0.1:6443
# SPECTRA_K8S_TOKEN=
# SPECTRA_K8S_CA_CERT=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt

# Ограничение обхода. Пусто = все namespace.
# Один namespace в списке — и запрос идёт точечно, что позволяет обойтись
# Role вместо ClusterRole.
# SPECTRA_K8S_NAMESPACES=shop,billing

# Что не смотреть никогда. Значения по умолчанию — namespace, где Ingress
# бывают, а документированных API не бывает: ACME-челленджи cert-manager
# иначе опрашивались бы на каждом обходе.
SPECTRA_K8S_EXCLUDE_NAMESPACES=kube-system,kube-public,kube-node-lease,cert-manager

# Учитывать только эти ingressClassName. Пусто = все.
# SPECTRA_K8S_INGRESS_CLASSES=nginx

# Куда стучаться: service | ingress.
#
#   service — backend-Service внутри кластера (по умолчанию). Прямой вызов,
#             который не уходит на внешний балансировщик.
#   ingress — публичный хост из правила Ingress.
#
# Выбор здесь — только про то, какой адрес основной. Второй сохраняется как
# запасной: если основной не отвечает, опрос идёт по нему, и сервис не
# считается упавшим. После починки ближайшее сканирование вернёт основной.
SPECTRA_K8S_TARGET=service

# Как часто перечитывать список Ingress. Это не опрос сервисов — это
# обновление самого реестра.
SPECTRA_K8S_SYNC_INTERVAL=1h


# ────────────────────────────────────────────────── доступ и сеть ──

# «Try it out» через портал. Выключено намеренно: включённый прокси
# превращает Spectra в путь к внутренним API, а своей аутентификации у
# чтения нет. Включать только за SSO.
SPECTRA_PROXY_ENABLED=false

# Проверка TLS-сертификатов у опрашиваемых сервисов.
#
# Внутренние сервисы часто стоят за сертификатами корпоративного центра
# сертификации или за самоподписанными. Системный набор корней о них не знает,
# и опрос упирается в ошибку проверки при живом сервисе. В интерфейсе это видно
# строкой «сертификат сервиса не прошёл проверку».
#
# Способа два, и они не равнозначны:
#
#   SPECTRA_CA_BUNDLE      — сказать порталу, кому верить. Проверка остаётся.
#                            Файл PEM, добавляется к системным корням, а не
#                            заменяет их. Предпочтительный вариант.
#   SPECTRA_TLS_SKIP_VERIFY — не проверять вовсе. Соединение остаётся
#                            шифрованным, но подтвердить, что на том конце тот,
#                            за кого он себя выдаёт, уже нельзя.
#
# На Kubernetes не влияет: у API-сервера свой CA из ServiceAccount, и его
# проверка не ослабляется никогда — вместе с запросом уходит токен.
# SPECTRA_CA_BUNDLE=/etc/spectra/corporate-ca.pem
SPECTRA_TLS_SKIP_VERIFY=false

# Как портал представляется опрашиваемым сервисам. Осмысленное значение
# экономит время тому, кто увидит эти запросы в чужих логах и пойдёт
# выяснять, кто это ходит.
SPECTRA_USER_AGENT=spectra/2.0

# Учётные данные администратора: закрывают страницу настроек и все операции
# записи. Чтение списка и спек остаётся открытым — портал доступен из
# корпоративной сети, и смотреть API не должно требовать логина.
# Пустой пароль = запись выключена совсем.
# В Kubernetes держите это в Secret, а не в ConfigMap.
SPECTRA_ADMIN_USER=admin
SPECTRA_ADMIN_PASSWORD=

# Сервисы, добавляемые в реестр списком, помимо кластера. Без этого портал
# нечем наполнить вне Kubernetes — ни для локальной пробы, ни для тех
# нескольких сервисов, что живут не в кластере.
# SPECTRA_STATIC_SERVICES=http://orders.internal:8080,https://billing.example.com

# RabbitMQ: брокеры, чью топологию показывать. имя=адрес management API через
# запятую; без этой переменной раздел не включается. Пароля в адресе быть не
# должно — адрес попадает в логи и ConfigMap, для пароля есть свои переменные.
# Пользователю нужен тег monitoring и права в каждом vhost (см. deploy/DEPLOY.md).
# SPECTRA_RABBITMQ_BROKERS=prod=http://rabbit-prod:15672,stage=http://rabbit-stage:15672
# SPECTRA_RABBITMQ_USER=spectra
# SPECTRA_RABBITMQ_PASSWORD=
# Свой пароль для одного брокера: имя заглавными, «-» → «_».
# SPECTRA_RABBITMQ_STAGE_PASSWORD=


# ─────────────────────────────────────────────────────── разработка ──

# База для `make test`. Тесты создают в ней отдельную схему на каждый тест и
# удаляют её за собой, но всё же не указывайте сюда рабочую базу.
# Makefile поднимает временный Postgres сам, так что задавать это вручную
# нужно, только если хочется свой.
# SPECTRA_TEST_DATABASE_URL=postgres://postgres:test@localhost:55432/spectra?sslmode=disable
